{
  "name": "@portal/server",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "workers": "concurrently \"npm run worker:email\" \"npm run worker:pdf\" \"npm run worker:ai\"",
    "worker:email": "tsx src/shared/queue/workers/email.worker.ts",
    "worker:pdf": "tsx src/shared/queue/workers/pdf.worker.ts",
    "worker:ai": "tsx src/shared/queue/workers/ai.worker.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.3",
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/multipart": "^8.3.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/websocket": "^10.0.1",
    "@portal/types": "workspace:*",
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "@prisma/config": "^7.6.0",
    "@types/pg": "^8.20.0",
    "axios": "^1.7.2",
    "bcryptjs": "^2.4.3",
    "bull": "^4.12.9",
    "date-fns": "^3.6.0",
    "fastify": "^4.27.0",
    "fastify-plugin": "^5.1.0",
    "ioredis": "^5.4.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.20.0",
    "resend": "^3.2.0",
    "socket.io": "^4.7.5",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.12.7",
    "@types/uuid": "^9.0.8",
    "concurrently": "^8.2.2",
    "prisma": "^7.6.0",
    "tsx": "^4.8.2",
    "typescript": "^5.4.5"
  }
}
