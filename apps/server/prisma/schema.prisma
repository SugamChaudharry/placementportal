generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Core ────────────────────────────────────────────────────────────────────
model User {
  id           String   @id @default(cuid())
  name         String
  username     String?  @unique
  email        String   @unique
  passwordHash String
  role         Role     @default(student)
  avatar       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student      Student?
  recruiter    Recruiter?
  sentMessages Message[]
  notifications Notification[]

  @@map("users")
}

enum Role {
  student
  recruiter
  admin
}


// ─── Student ─────────────────────────────────────────────────────────────────
model Student {
  id             String   @id @default(cuid())
  userId         String   @unique
  college        String?
  branch         String?
  degree         String?
  cgpa           Float?
  graduationYear Int?
  phone          String?
  linkedinUrl    String?
  githubUrl      String?
  bio            String?
  skills         String[]
  backlogs       Int      @default(0)
  resumeUrl      String?
  profileComplete Int     @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications   Application[]

  @@map("students")
}

// ─── Recruiter ────────────────────────────────────────────────────────────────
model Recruiter {
  id                 String             @id @default(cuid())
  userId             String             @unique
  companyId          String?
  designation        String?
  verificationStatus VerificationStatus @default(PENDING)
  submittedAt        DateTime           @default(now())
  verifiedAt         DateTime?
  adminNotes         String?

  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company     Company? @relation(fields: [companyId], references: [id])
  jobs        Job[]

  @@map("recruiters")
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─── Company ─────────────────────────────────────────────────────────────────
model Company {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  logo        String?
  color       String   @default("#4f46e5")
  website     String?
  industry    String?
  size        String?
  description String?
  createdAt   DateTime @default(now())

  recruiters  Recruiter[]
  jobs        Job[]

  @@map("companies")
}

// ─── Job ─────────────────────────────────────────────────────────────────────
model Job {
  id           String    @id @default(cuid())
  title        String
  description  String
  location     String
  ctc          String
  type         JobType   @default(FULL_TIME)
  skills       String[]
  deadline     DateTime
  minCgpa      Float     @default(0)
  branches     String[]
  maxBacklogs  Int       @default(0)
  status       JobStatus @default(OPEN)
  companyId    String
  recruiterId  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company      Company      @relation(fields: [companyId], references: [id])
  recruiter    Recruiter    @relation(fields: [recruiterId], references: [id])
  applications Application[]

  @@map("jobs")
}

enum JobType {
  FULL_TIME
  INTERNSHIP
  PPO
}

enum JobStatus {
  OPEN
  CLOSED
  DRAFT
}


// ─── Application ──────────────────────────────────────────────────────────────
model Application {
  id        String    @id @default(cuid())
  studentId String
  jobId     String
  status    AppStatus @default(APPLIED)
  resumeUrl String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([studentId, jobId])
  @@map("applications")
}

enum AppStatus {
  APPLIED
  SHORTLISTED
  TEST_SCHEDULED
  TEST_COMPLETED
  INTERVIEW_SCHEDULED
  INTERVIEW_COMPLETED
  OFFERED
  REJECTED
}


// ─── Coding Test ──────────────────────────────────────────────────────────────
model CodingTest {
  id               String     @id @default(cuid())
  name             String
  jobId            String?
  durationMinutes  Int        @default(90)
  scheduledAt      DateTime
  endsAt           DateTime
  languages        String[]
  cameraRequired   Boolean    @default(true)
  tabSwitchLimit   Int        @default(3)
  status           TestStatus @default(DRAFT)
  createdAt        DateTime   @default(now())

  questions        TestQuestion[]
  submissions      TestSubmission[]

  @@map("coding_tests")
}

enum TestStatus {
  DRAFT
  PUBLISHED
  ACTIVE
  ENDED
}


model TestQuestion {
  id          String   @id @default(cuid())
  testId      String
  title       String
  description String
  difficulty  Difficulty @default(MEDIUM)
  marks       Int        @default(10)
  timeLimit   Int        @default(2000)
  memoryLimit Int        @default(256)
  tags        String[]

  test        CodingTest @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@map("test_questions")
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}


model TestSubmission {
  id          String   @id @default(cuid())
  testId      String
  studentId   String
  code        String
  language    String
  score       Float    @default(0)
  flagCount   Int      @default(0)
  submittedAt DateTime @default(now())

  test        CodingTest @relation(fields: [testId], references: [id])

  @@map("test_submissions")
}

// ─── Chat ─────────────────────────────────────────────────────────────────────
model ChatRoom {
  id        String   @id @default(cuid())
  name      String
  type      RoomType @default(GROUP)
  jobId     String?
  createdAt DateTime @default(now())
  messages  Message[]

  @@map("chat_rooms")
}

enum RoomType {
  GROUP
  DM
  ANNOUNCEMENT
}


model Message {
  id        String      @id @default(cuid())
  roomId    String
  senderId  String
  content   String
  type      MessageType @default(TEXT)
  createdAt DateTime    @default(now())

  room      ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@map("messages")
}

enum MessageType {
  TEXT
  FILE
  IMAGE
}


// ─── Meeting ──────────────────────────────────────────────────────────────────
model Meeting {
  id              String        @id @default(cuid())
  title           String
  type            MeetingType   @default(TECHNICAL)
  scheduledAt     DateTime
  durationMinutes Int           @default(45)
  jobId           String?
  roomCode        String        @unique @default(cuid())
  status          MeetingStatus @default(SCHEDULED)
  recordingUrl    String?
  createdAt       DateTime      @default(now())

  @@map("meetings")
}

enum MeetingType {
  TECHNICAL
  HR
  GROUP_DISCUSSION
}

enum MeetingStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}


// ─── Notification ─────────────────────────────────────────────────────────────
model Notification {
  id        String       @id @default(cuid())
  userId    String
  type      NotifType    @default(INFO)
  title     String
  message   String
  read      Boolean      @default(false)
  actionUrl String?
  createdAt DateTime     @default(now())

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

enum NotifType {
  SUCCESS
  INFO
  WARNING
  ERROR
}

